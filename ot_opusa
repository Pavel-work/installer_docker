        printf '  Параметры:  %s\n' "$PARAMS_FILE"
        printf '  Compose:    %s/docker-compose.yml\n' "$SETUP_DIR"
        printf '════════════════════════════════════════════════════════\n'
    } > "$sf"
    chmod 600 "$sf"
    dialog --title "Итоги установки" --textbox "$sf" 32 80
}

reinstall_service() {
    local svc="$1"
    cd "$SETUP_DIR" || return 1
    case "$svc" in
        supabase)
            dialog --yes-label "Удалить ВСЕ" --no-label "Отмена" \
                --yesno "Переустановить Supabase?\n\nВСЕ ДАННЫЕ БУДУТ УДАЛЕНЫ!\nСделайте backup заранее." 9 60 \
                || return 0
            docker compose -p supabase down -v >>"$LOG_FILE" 2>&1 || true
            rm -rf supabase-docker
            setup_supabase
            ;;
        cloudflared)
            generate_compose_file
            docker compose stop cloudflared    >>"$LOG_FILE" 2>&1 || true
            docker compose rm -fv cloudflared  >>"$LOG_FILE" 2>&1 || true
            setup_cloudflared
            docker compose up -d cloudflared   >>"$LOG_FILE" 2>&1
            verify_cloudflared
            ;;
        *)
            generate_compose_file
            docker compose stop "$svc"    >>"$LOG_FILE" 2>&1 || true
            docker compose rm -fv "$svc"  >>"$LOG_FILE" 2>&1 || true
            docker compose up -d "$svc"   >>"$LOG_FILE" 2>&1
            ;;
    esac
    info_box "Готово" "${svc} переустановлен." 2
}

show_status() {
    local st
    st=$(_mktemp)
    {
        printf '── docker compose ps (основные) ──\n'
        if [[ -f "$SETUP_DIR/docker-compose.yml" ]]; then
            (cd "$SETUP_DIR" && docker compose ps 2>&1) || echo "(нет)"
        else
            echo "(docker-compose.yml отсутствует)"
        fi
        printf '\n── docker compose ps (supabase) ──\n'
        if [[ -d "$SETUP_DIR/supabase-docker" ]]; then
            (cd "$SETUP_DIR/supabase-docker" && docker compose -p supabase ps 2>&1) || echo "(нет)"
        else
            echo "(не установлен)"
        fi
        printf '\n── Все контейнеры ──\n'
        docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || true
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^cloudflared$'; then
            printf '\n── Cloudflared последние логи ──\n'
            docker logs --tail 15 cloudflared 2>&1 || true
        fi
    } > "$st"
    dialog --title "Статус" --textbox "$st" 30 100
}

post_install_menu() {
    while true; do
        local c
        c=$(dialog --title "Управление" --cancel-label "Выход" \
            --menu "Выберите действие:" 20 65 9 \
            "1" "Добавить/изменить сервисы" \
            "2" "Переустановить сервис" \
            "3" "Показать статус" \
            "4" "Показать сводку" \
            "5" "Просмотр логов" \
            "6" "Полный сброс" \
            "7" "Копировать лог в /tmp" \
            "0" "Выход" \
            3>&1 1>&2 2>&3) || return 0
        case "$c" in
            1)
                show_service_menu || continue
                [[ ${#SELECTED_ARRAY[@]} -eq 0 ]] && { info_box "" "Ничего не выбрано" 2; continue; }
                input_parameters || continue
                save_params
                setup_network
                setup_cloudflared
                generate_compose_file
                start_containers
                print_npm_info
                setup_supabase
                verify_cloudflared
                show_final_summary
                ;;
            2)
                local arr=() names svc
                names=$(docker ps --format '{{.Names}}' 2>/dev/null) || names=""
                for svc in postgres qdrant ollama apache nginx-proxy-manager cloudflared portainer n8n; do
                    printf '%s\n' "$names" | grep -qx "$svc" && arr+=("$svc" "$svc" off)
                done
                printf '%s\n' "$names" | grep -q "^supabase-" && arr+=("supabase" "Supabase (все)" off)
                if [[ ${#arr[@]} -eq 0 ]]; then
                    info_box "" "Нет запущенных сервисов" 2
                    continue
                fi
                local sel
                sel=$(_mktemp)
                dialog --checklist "Выберите для переустановки:" 16 60 8 "${arr[@]}" 2>"$sel" || continue
                local raw item
                raw=$(tr -d '"\r' <"$sel")
                for item in $raw; do
                    [[ -n "$item" ]] && reinstall_service "$item"
                done
                ;;
            3) show_status ;;
            4) show_final_summary ;;
            5) dialog --title "Лог" --textbox "$LOG_FILE" 32 100 ;;
            6)
                dialog --yes-label "Удалить" --no-label "Отмена" \
                    --yesno "ПОЛНЫЙ СБРОС.\n\nБудет удалено:\n  • $STATE_DIR\n  • $SETUP_DIR\n  • Все контейнеры (с томами!)" 11 60 \
                    || continue
                (cd "$SETUP_DIR" 2>/dev/null && docker compose down -v 2>/dev/null || true)
                (cd "$SETUP_DIR/supabase-docker" 2>/dev/null && docker compose -p supabase down -v 2>/dev/null || true)
                rm -rf "$STATE_DIR" "$SETUP_DIR"
                info_box "Готово" "Сброшено. Перезапуск..." 2
                exec "$0"
                ;;
            7)
                cp "$LOG_FILE" /tmp/install.log 2>/dev/null && chmod 644 /tmp/install.log
                local ip; ip=$(hostname -I | awk '{print $1}')
                dialog --title "Лог скопирован" --msgbox \
"  /tmp/install.log

Скачайте локально:
  scp root@${ip}:/tmp/install.log ." 11 60
                ;;
            0) return 0 ;;
        esac
    done
}

main() {
    if ! grep -qi "ubuntu\|debian" /etc/os-release 2>/dev/null; then
        echo "Только Ubuntu/Debian"
        exit 1
    fi
    if [[ "$EUID" -ne 0 ]]; then
        echo "Запустите с sudo"
        exit 1
    fi
    if ! command -v dialog &>/dev/null; then
        apt-get update >/dev/null 2>&1 || true
        apt-get install -y dialog >/dev/null 2>&1 || {
            echo "Не удалось установить dialog"; exit 1; }
    fi

    local avail_gb
    avail_gb=$(df -BG / | awk 'NR==2{gsub(/G/,""); print $4}')
    if [[ "$avail_gb" =~ ^[0-9]+$ ]] && [[ $avail_gb -lt 5 ]]; then
        dialog --msgbox "Свободно ${avail_gb}GB, нужно ≥5GB" 7 50
        exit 1
    fi

    load_selected_services
    load_params

    if [[ $# -eq 2 ]] && [[ "$1" == "--reinstall" ]]; then
        reinstall_service "$2"
        exit 0
    fi

    local state
    state=$(get_state)
    case "$state" in
        start)
            show_welcome
            show_service_menu || exit 0
            [[ ${#SELECTED_ARRAY[@]} -eq 0 ]] && {
                dialog --msgbox "Ничего не выбрано" 6 40; exit 1; }
            input_parameters || { save_state "start"; exit 4; }
            ensure_docker
            save_state "docker_installed"
            setup_network
            setup_cloudflared
            generate_compose_file
            start_containers
            print_npm_info
            setup_supabase
            verify_cloudflared
            save_state "completed"
            show_final_summary
            ;;
        docker_installed|completed)
            ensure_docker
            setup_network
            setup_cloudflared
            generate_compose_file
            start_containers
            print_npm_info
            setup_supabase
            verify_cloudflared
            save_state "completed"
            show_final_summary
            ;;
        *)
            save_state "start"
            exec "$0"
            ;;
    esac

    post_install_menu
}

main "$@"
