s_cf_routes() {
    local candidates=()
    is_selected "n8n"       && candidates+=("n8n"       "→ n8n:5678"             on)
    is_selected "portainer" && candidates+=("portainer" "→ portainer:9000"       off)
    is_selected "apache"    && candidates+=("apache"    "→ apache:80"            off)
    is_selected "qdrant"    && candidates+=("qdrant"    "→ qdrant:6333"          off)
    is_selected "ollama"    && candidates+=("ollama"    "→ ollama:11434"         off)
    is_selected "nginx_proxy" && candidates+=("npm"     "→ NPM admin :81"        off)
    is_selected "supabase"  && candidates+=("supabase-studio" "→ supabase-studio:3000" off)
    is_selected "supabase"  && candidates+=("supabase-api"    "→ supabase-kong:8000"   off)

    if [[ ${#candidates[@]} -eq 0 ]]; then
        dialog --msgbox "Нет сервисов для маршрутизации.\nДобавьте n8n/portainer/etc." 7 55
        _nav_action="next"
        return 0
    fi

    if [[ -n "$CLOUDFLARE_ROUTES" ]]; then
        local route_name i
        for ((i=0; i<${#candidates[@]}; i+=3)); do
            for route_name in ${CLOUDFLARE_ROUTES//,/ }; do
                if [[ "$route_name" == "${candidates[$i]}" ]]; then
                    candidates[$((i+2))]="on"
                fi
            done
        done
    fi

    local _sel
    _sel=$(_mktemp)
    dialog --title "Маршруты Cloudflare Tunnel" \
        --ok-label "Далее" --cancel-label "Назад" \
        --checklist "Сервисы для публикации (создаются поддомены вида\nn8n.${CLOUDFLARE_DOMAIN:-домен}):" \
        20 72 9 "${candidates[@]}" 2>"$_sel" \
        || { _nav_action="back"; return 1; }

    local raw routes=() item
    raw=$(tr -d '"\r' <"$_sel")
    for item in $raw; do
        [[ -n "$item" ]] && routes+=("$item")
    done
    CLOUDFLARE_ROUTES=""
    if [[ ${#routes[@]} -gt 0 ]]; then
        CLOUDFLARE_ROUTES=$(IFS=','; echo "${routes[*]}")
    fi

    if [[ ${#routes[@]} -gt 0 ]]; then
        local preview
        preview=$(_mktemp)
        {
            printf 'Будут созданы маршруты:\n\n'
            local r host service
            for r in "${routes[@]}"; do
                cf_route_to_host_service "$r" host service
                printf '  %-40s → %s\n' "${host}" "${service}"
            done
            printf '\n'
            if [[ "$CLOUDFLARE_MODE" == "token" ]]; then
                printf '⚠ В режиме TOKEN маршруты добавьте вручную:\n'
                printf '   dashboard.cloudflare.com → Tunnels →\n'
                printf '   ваш тоннель → Public Hostnames → Add\n'
            else
                printf '✓ В режиме CONFIG маршруты применятся автоматически.\n'
                printf '  Не забудьте создать DNS-записи (CNAME → ID.cfargotunnel.com)\n'
                printf '  через: cloudflared tunnel route dns <name> <hostname>\n'
            fi
        } > "$preview"
        dialog --title "Превью маршрутов" --textbox "$preview" 20 75
    fi
}

cf_route_to_host_service() {
    local key="$1" host_ref="$2" svc_ref="$3"
    local h s
    case "$key" in
        n8n)             h="n8n.${CLOUDFLARE_DOMAIN}";       s="http://n8n:5678" ;;
        portainer)       h="portainer.${CLOUDFLARE_DOMAIN}"; s="http://portainer:9000" ;;
        apache)          h="${CLOUDFLARE_DOMAIN}";           s="http://apache:80" ;;
        qdrant)          h="qdrant.${CLOUDFLARE_DOMAIN}";    s="http://qdrant:6333" ;;
        ollama)          h="ollama.${CLOUDFLARE_DOMAIN}";    s="http://ollama:11434" ;;
        npm)             h="npm.${CLOUDFLARE_DOMAIN}";       s="http://nginx-proxy-manager:81" ;;
        supabase-studio) h="studio.${CLOUDFLARE_DOMAIN}";    s="http://supabase-studio:3000" ;;
        supabase-api)    h="api.${CLOUDFLARE_DOMAIN}";       s="http://supabase-kong:8000" ;;
        *)               h=""; s="" ;;
    esac
    printf -v "$host_ref" "%s" "$h"
    printf -v "$svc_ref"  "%s" "$s"
}

