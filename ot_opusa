        local k b t
        for k in "${!_PM[@]}"; do
            if b=$(load_param_b64 "$PARAMS_FILE" "${_PM[$k]}"); then
                t=$(b64dec "$b")
                [[ -n "$t" ]] && printf -v "$k" "%s" "$t"
            fi
        done
    fi

    [[ "$N8N_PORT"             =~ ^[0-9]+$ ]] || N8N_PORT=5678
    [[ "$APACHE_HTTP_PORT"     =~ ^[0-9]+$ ]] || APACHE_HTTP_PORT=8080
    [[ "$QDRANT_PORT"          =~ ^[0-9]+$ ]] || QDRANT_PORT=6333
    [[ "$PORTAINER_PORT"       =~ ^[0-9]+$ ]] || PORTAINER_PORT=9000
    [[ "$OLLAMA_PORT"          =~ ^[0-9]+$ ]] || OLLAMA_PORT=11434
    [[ "$N8N_DB_POSTGRES"      =~ ^[01]$   ]] || N8N_DB_POSTGRES=0
    [[ "$DOMAIN_HTTPS"         =~ ^[01]$   ]] || DOMAIN_HTTPS=0
    [[ "$SUPABASE_HTTPS"       =~ ^[01]$   ]] || SUPABASE_HTTPS=0
    [[ "$SUPABASE_PORT_STUDIO" =~ ^[0-9]+$ ]] || SUPABASE_PORT_STUDIO=3000
    [[ "$SUPABASE_PORT_PG"     =~ ^[0-9]+$ ]] || SUPABASE_PORT_PG=5432
    [[ "$SUPABASE_PORT_API"    =~ ^[0-9]+$ ]] || SUPABASE_PORT_API=8000
    [[ "$SUPABASE_PORT_POOLER" =~ ^[0-9]+$ ]] || SUPABASE_PORT_POOLER=6543
    [[ "$CLOUDFLARE_MODE" == "token" || "$CLOUDFLARE_MODE" == "config" ]] || CLOUDFLARE_MODE=""
}

run_with_progress() {
    local title="$1" desc="$2"; shift 2
    local logmark="/tmp/.progress_$$_$RANDOM"
    (
        "$@" >>"$LOG_FILE" 2>&1
        echo $? > "$logmark"
    ) &
    local cmd_pid=$!

    local pct=0
    (
        while kill -0 "$cmd_pid" 2>/dev/null; do
            echo "$pct"
            echo "XXX"
            echo "$desc"
            echo "XXX"
            pct=$((pct + 3))
            [[ $pct -gt 95 ]] && pct=95
            sleep 1
        done
        echo "100"
    ) | dialog --title "$title" --gauge "$desc" 9 70 0

    wait "$cmd_pid" 2>/dev/null || true
    local rc=0
    [[ -f "$logmark" ]] && rc=$(<"$logmark") && rm -f "$logmark"
    return "$rc"
}

info_box() {
    local title="$1" msg="$2" sec="${3:-2}"
    dialog --title "$title" --infobox "$msg" 7 60
    sleep "$sec"
}

_nav_action="next"
_STEP=0
_STEP_MAX=0
_STEP_LABELS=()
_STEP_FUNC=()

step_reg() { _STEP_LABELS+=("$1"); _STEP_FUNC+=("$2"); }

build_steps() {
    _STEP_LABELS=()
    _STEP_FUNC=()
    _STEP=0
    is_selected "postgres"    && step_reg "PostgreSQL пароль"   "s_pg"
    is_selected "ollama"      && step_reg "LLM Provider"        "s_llm"
    if is_selected "apache" || is_selected "n8n" || \
       is_selected "nginx_proxy" || is_selected "supabase"; then
        step_reg "Домен"                                        "s_domain"
    fi
    is_selected "n8n"         && step_reg "n8n порт"            "s_n8n_port"
    is_selected "n8n" && is_selected "postgres" && \
        step_reg "n8n: Postgres или SQLite?"                    "s_n8n_db"
    is_selected "supabase"    && step_reg "Supabase поддомен"   "s_supabase_domain"
    is_selected "supabase"    && step_reg "JWT Secret"          "s_jwt"
    is_selected "supabase"    && step_reg "Supabase порты"      "s_supabase_ports"
    is_selected "apache"      && step_reg "Apache путь"         "s_ap_path"
    is_selected "apache"      && step_reg "Apache порт"         "s_ap_port"
    is_selected "qdrant"      && step_reg "Qdrant порт"         "s_qdrant_port"
    is_selected "portainer"   && step_reg "Portainer порт"      "s_portainer_port"
    is_selected "ollama"      && step_reg "Ollama порт"         "s_ollama_port"
    is_selected "cloudflared" && step_reg "Cloudflare режим"    "s_cf_mode"
    is_selected "cloudflared" && step_reg "Cloudflare данные"   "s_cf_creds"
    is_selected "cloudflared" && step_reg "Cloudflare маршруты" "s_cf_routes"
    step_reg "Подтверждение"                                    "s_confirm"
    _STEP_MAX=${#_STEP_LABELS[@]}
}

input_port() {
    local label="$1" varname="$2" default_port="$3"
    while true; do
        local default_val="${!varname:-$default_port}"
        dialog --ok-label "Далее" --cancel-label "Назад" \
            --title "Порт $label" \
            --inputbox "Укажите порт для $label:" 8 60 "$default_val" 2>"$TMP" \
            || { _nav_action="back"; return 1; }
        local val
        val=$(<"$TMP")
        if [[ "$val" =~ ^[0-9]+$ ]] && [[ $val -ge 1 ]] && [[ $val -le 65535 ]]; then
            printf -v "$varname" "%s" "$val"
        else
            printf -v "$varname" "%s" "$default_port"
        fi
        check_port "${!varname}" && return 0
    done
}

s_pg() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "[$((_STEP+1))/${_STEP_MAX}] PostgreSQL" \
        --inputbox "Пароль admin (пусто = сгенерировать)" \
        10 65 "${PGPASSWORD:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    PGPASSWORD=$(<"$TMP")
    [[ -z "$PGPASSWORD" ]] && \
        PGPASSWORD=$(openssl rand -base64 24 | tr -d '+=/' | cut -c1-24)
    dialog --title "PostgreSQL пароль установлен" --ok-label "Далее" \
        --msgbox "Сохраните пароль:\n\n${PGPASSWORD}\n\n(виден также в ${PARAMS_FILE})" 11 65
}

s_llm() {
    LLM_TYPE=$(dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "[$((_STEP+1))/${_STEP_MAX}] LLM Provider" \
        --radiolist "Выберите LLM провайдер:" 15 60 5 \
        "ollama"    "Ollama (локально)"    on \
        "openai"    "OpenAI"               off \
        "anthropic" "Anthropic Claude"     off \
        "deepseek"  "DeepSeek"             off \
        "custom"    "Custom URL"           off \
        3>&1 1>&2 2>&3) || { _nav_action="back"; return 1; }
    case "$LLM_TYPE" in
        openai)    LLM_API_URL="https://api.openai.com/v1" ;;
        anthropic) LLM_API_URL="https://api.anthropic.com/v1" ;;
        ollama)    LLM_API_URL="http://ollama:11434"; LLM_API_KEY="" ;;
        deepseek)  LLM_API_URL="https://api.deepseek.com/v1" ;;
        custom)
            dialog --ok-label "Далее" --cancel-label "Назад" \
                --inputbox "Введите URL API:" 9 60 "${LLM_API_URL:-}" 2>"$TMP" \
                || { _nav_action="back"; return 1; }
            LLM_API_URL=$(<"$TMP")
            ;;
    esac
    if [[ "$LLM_TYPE" != "ollama" ]]; then
        dialog --ok-label "Далее" --cancel-label "Назад" \
            --inputbox "API ключ для ${LLM_TYPE}:" 9 60 "${LLM_API_KEY:-}" 2>"$TMP" \
            || { _nav_action="back"; return 1; }
        LLM_API_KEY=$(<"$TMP")
    fi
}

s_domain() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "Домен" \
        --inputbox "Основной домен (пусто если нет):\n\nПример: example.com" \
        9 60 "${DOMAIN:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    DOMAIN=$(<"$TMP")
    if [[ -n "$DOMAIN" ]]; then
        if dialog --title "HTTPS" \
            --yes-label "Да (HTTPS)" --no-label "Нет (HTTP)" \
            --yesno "Доступ к домену по HTTPS?\n\n(Да — если настроен SSL через NPM/Cloudflare)" 8 60; then
            DOMAIN_HTTPS=1
        else
            DOMAIN_HTTPS=0
        fi
    else
        DOMAIN_HTTPS=0
    fi
}

s_n8n_port() { input_port "n8n" N8N_PORT 5678; }

s_n8n_db() {
    if dialog --yes-label "PostgreSQL" --no-label "SQLite" \
        --title "n8n База данных" \
        --yesno "Какую БД использовать для n8n?\n\nДа = PostgreSQL (рекомендуется)\nНет = SQLite" 9 60; then
        N8N_DB_POSTGRES=1
    else
        N8N_DB_POSTGRES=0
    fi
    _nav_action="next"
}

s_supabase_domain() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --inputbox "Поддомен Supabase (пусто если нет):\n\nПример: supabase.example.com" \
        9 60 "${SUPABASE_DOMAIN:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    SUPABASE_DOMAIN=$(<"$TMP")
    if [[ -n "$SUPABASE_DOMAIN" ]]; then
        if dialog --yes-label "Да" --no-label "Нет" \
            --yesno "Supabase доступен по HTTPS?" 7 50; then
            SUPABASE_HTTPS=1
        else
            SUPABASE_HTTPS=0
        fi
    else
        SUPABASE_HTTPS=0
    fi
}

s_jwt() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "JWT Secret" \
        --inputbox "Секрет JWT (пусто = сгенерировать; ≥32 симв.)" \
        9 65 "${JWT_SECRET:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    JWT_SECRET=$(<"$TMP")
    if [[ -z "$JWT_SECRET" ]] || [[ ${#JWT_SECRET} -lt 32 ]]; then
        JWT_SECRET=$(openssl rand -hex 32)
    fi
    dialog --title "JWT Secret установлен" --ok-label "Далее" \
        --msgbox "JWT Secret:\n\n${JWT_SECRET}\n\nСохранён в ${PARAMS_FILE}" 11 75
}

s_supabase_ports() {
    while true; do
        local _sf
        _sf=$(_mktemp)
        {
            printf 'Порты Supabase (внешние):\n\n'
            printf '  Studio (Dashboard)  : %s\n' "$SUPABASE_PORT_STUDIO"
            printf '  Database (PostgreSQL): %s\n' "$SUPABASE_PORT_PG"
            printf '  API Gateway (Kong)  : %s\n' "$SUPABASE_PORT_API"
            printf '  Pooler (Supavisor)  : %s\n' "$SUPABASE_PORT_POOLER"
            printf '\nИспользуйте Database порт для подключения n8n:\n'
            printf '  host=<IP> port=%s user=postgres\n' "$SUPABASE_PORT_PG"
        } > "$_sf"
        if dialog --title "Supabase порты" \
            --yes-label "Далее" --no-label "Изменить" \
            --yesno "$(cat "$_sf")" 18 60; then
            _nav_action="next"
            return 0
        fi

        local _cancelled=0
        local pv label dv
        for pv in SUPABASE_PORT_STUDIO SUPABASE_PORT_PG SUPABASE_PORT_API SUPABASE_PORT_POOLER; do
            case "$pv" in
                SUPABASE_PORT_STUDIO) label="Studio"   ; dv=3000 ;;
                SUPABASE_PORT_PG)     label="Database" ; dv=5432 ;;
                SUPABASE_PORT_API)    label="API/Kong" ; dv=8000 ;;
                SUPABASE_PORT_POOLER) label="Pooler"   ; dv=6543 ;;
            esac
            dialog --ok-label "OK" --cancel-label "Назад" \
                --inputbox "Порт ${label} (по умолч. ${dv}):" \
                8 55 "${!pv}" 2>"$TMP" \
                || { _cancelled=1; break; }
            local val
            val=$(<"$TMP")
            if [[ "$val" =~ ^[0-9]+$ ]] && [[ $val -ge 1 ]] && [[ $val -le 65535 ]]; then
                printf -v "$pv" "%s" "$val"
            fi
        done

        if [[ $_cancelled -eq 1 ]]; then
            _nav_action="back"
            return 1
        fi
    done
}

s_ap_path() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --inputbox "Путь для сайтов Apache:" 9 60 \
        "${APACHE_WWW_PATH:-$SETUP_DIR/www}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    APACHE_WWW_PATH=$(<"$TMP")
    [[ -z "$APACHE_WWW_PATH" ]] && APACHE_WWW_PATH="$SETUP_DIR/www"
    APACHE_WWW_PATH=$(realpath -m "$APACHE_WWW_PATH")
    mkdir -p "$APACHE_WWW_PATH" "$APACHE_WWW_PATH/conf"
    [[ ! -f "$APACHE_WWW_PATH/index.html" ]] && \
        echo '<h1>It works!</h1>' >"$APACHE_WWW_PATH/index.html"
}

