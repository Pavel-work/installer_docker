create_n8n_database() {
    local wait_sec=0
    log "n8n DB: waiting for postgres readiness..."
    while [[ $wait_sec -lt 90 ]]; do
        if docker exec -T postgres pg_isready -U admin -h localhost &>/dev/null; then
            log "  ✓ postgres ready (${wait_sec}s)"
            break
        fi
        sleep 3
        wait_sec=$((wait_sec + 3))
    done

    local attempt
    for attempt in 1 2 3; do
        local check rc=0
        check=$(docker exec -T postgres \
            psql -U admin -h localhost -d appdb -tA \
            -c "SELECT 1 FROM pg_database WHERE datname='n8n';" 2>&1) || rc=$?
        log "n8n DB check #$attempt rc=$rc out=$check"
        if [[ "$(printf '%s' "$check" | tr -d '[:space:]')" == "1" ]]; then
            log "n8n DB exists"
            return 0
        fi

        local result rc_c=0
        result=$(docker exec -T postgres \
            psql -U admin -h localhost -d appdb \
            -c "CREATE DATABASE n8n;" 2>&1) || rc_c=$?
        log "n8n DB create #$attempt rc=$rc_c out=$result"
        if [[ $rc_c -eq 0 ]] || printf '%s' "$result" | grep -qi "already\|created"; then
            log "n8n DB created"
            return 0
        fi
        sleep 5
    done
    log "WARN: n8n DB creation failed after 3 attempts, n8n will retry"
    return 0
}

start_containers() {
    cd "$SETUP_DIR" || return 1
    [[ ! -f docker-compose.yml ]] && return 0

    log_section "Starting main containers"

    if is_selected "postgres"; then
        info_box "Запуск" "Этап 1/3: PostgreSQL..." 1
        docker compose up -d postgres >>"$LOG_FILE" 2>&1

        local wait_sec=0
        while [[ $wait_sec -lt 60 ]]; do
            local hs
            hs=$(docker inspect --format '{{.State.Health.Status}}' postgres 2>/dev/null || echo "")
            [[ "$hs" == "healthy" ]] && break
            sleep 2
            wait_sec=$((wait_sec + 2))
        done

        if is_selected "n8n" && [[ "$N8N_DB_POSTGRES" == "1" ]]; then
            info_box "Запуск" "Этап 2/3: Создание БД n8n..." 1
            create_n8n_database
        fi

        info_box "Запуск" "Этап 3/3: Остальные сервисы..." 1
        docker compose up -d >>"$LOG_FILE" 2>&1
    else
        info_box "Запуск" "Запуск всех контейнеров..." 1
        docker compose up -d >>"$LOG_FILE" 2>&1
    fi

    sleep 10
    log "Containers after start:"
    docker ps --format "  {{.Names}}: {{.Status}}" >>"$LOG_FILE" 2>&1

    local running
    running=$(docker ps --filter "label=com.docker.compose.project" --format '{{.Names}}' 2>/dev/null | wc -l)
    if [[ $running -eq 0 ]]; then
        dialog --title "Ошибка" --msgbox "Контейнеры не запустились.\nЛог: $LOG_FILE" 8 60
        return 1
    fi
    log "Started: $running containers"
}

