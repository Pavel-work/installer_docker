supabase_wait_healthy() {
    local container="$1" max_wait="${2:-180}"
    local elapsed=0 status=""
    while [[ $elapsed -lt $max_wait ]]; do
        status=$(docker inspect --format '{{.State.Health.Status}}' \
                 "$container" 2>/dev/null || echo "missing")
        case "$status" in
            healthy) log "  ✓ $container healthy (${elapsed}s)"; return 0 ;;
            missing) log "  ✗ $container missing"; return 1 ;;
        esac
        sleep 3
        elapsed=$((elapsed + 3))
    done
    log "  ⚠ $container timeout ${max_wait}s (status: $status)"
    return 1
}

supabase_wait_pg_ready() {
    local container="$1" max_wait="${2:-120}"
    local elapsed=0
    while [[ $elapsed -lt $max_wait ]]; do
        if docker exec -T "$container" \
           pg_isready -U postgres -h localhost &>/dev/null; then
            log "  ✓ $container ready (${elapsed}s)"
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    log "  ⚠ $container not ready after ${max_wait}s"
    return 1
}

# Генерирует валидный JWT подписанный HMAC-SHA256.
# $1 = payload JSON строка, $2 = secret
# Возвращает JWT token
_jwt_sign() {
    local payload="$1" secret="$2"
    local header='{"alg":"HS256","typ":"JWT"}'

    # base64url без паддинга
    local b64url_header b64url_payload
    b64url_header=$(printf '%s' "$header"  | base64 -w0 | tr '+/' '-_' | tr -d '=')
    b64url_payload=$(printf '%s' "$payload" | base64 -w0 | tr '+/' '-_' | tr -d '=')

    local signing_input="${b64url_header}.${b64url_payload}"

    # HMAC-SHA256 подпись через openssl
    local signature
    signature=$(printf '%s' "$signing_input" \
        | openssl dgst -binary -sha256 -hmac "$secret" \
        | base64 -w0 | tr '+/' '-_' | tr -d '=')

    printf '%s.%s.%s' "$b64url_header" "$b64url_payload" "$signature"
}

supabase_download() {
    if [[ -d "$SETUP_DIR/supabase-docker" ]] && \
       [[ -f "$SETUP_DIR/supabase-docker/docker-compose.yml" ]]; then
        return 0
    fi

    log "Downloading Supabase docker files..."
    rm -rf "$SETUP_DIR/supabase-docker"
    mkdir -p "$SETUP_DIR/supabase-docker"

    local base_url="https://raw.githubusercontent.com/supabase/supabase/master/docker"
    local files=(
        "docker-compose.yml"
        ".env.example"
        "volumes/db/webhooks.sql"
        "volumes/db/realtime.sql"
        "volumes/db/roles.sql"
        "volumes/db/jwt.sql"
        "volumes/db/logs.sql"
        "volumes/db/pooler.sql"
        "volumes/db/_supabase.sql"
        "volumes/api/kong-entrypoint.sh"
        "volumes/api/kong.yml"
        "volumes/pooler/pooler.exs"
        "volumes/logs/vector.yml"
    )

    local f localpath
    for f in "${files[@]}"; do
        localpath="$SETUP_DIR/supabase-docker/$f"
        mkdir -p "$(dirname "$localpath")"
        log "  GET $f"
        if ! curl -fsSL --retry 3 --retry-delay 5 \
             -o "$localpath" "$base_url/$f" >>"$LOG_FILE" 2>&1; then
            log "  ERROR: failed to download $f"
            rm -rf "$SETUP_DIR/supabase-docker"
            return 1
        fi
    done

    chmod +x "$SETUP_DIR/supabase-docker/volumes/api/kong-entrypoint.sh" \
        2>/dev/null || true

    mkdir -p "$SETUP_DIR/supabase-docker/volumes/functions/main"
    mkdir -p "$SETUP_DIR/supabase-docker/volumes/functions/user"

    log "Supabase: download OK"
    return 0
}

supabase_validate_volumes() {
    log "Supabase: validating volumes..."
    local base_url="https://raw.githubusercontent.com/supabase/supabase/master/docker"
    local files=(
        "volumes/db/webhooks.sql"
        "volumes/db/realtime.sql"
        "volumes/db/roles.sql"
        "volumes/db/jwt.sql"
        "volumes/db/logs.sql"
        "volumes/db/pooler.sql"
        "volumes/db/_supabase.sql"
        "volumes/api/kong-entrypoint.sh"
        "volumes/api/kong.yml"
        "volumes/pooler/pooler.exs"
        "volumes/logs/vector.yml"
    )
    local f path repaired=0
    for f in "${files[@]}"; do
        path="$SETUP_DIR/supabase-docker/$f"
        if [[ -d "$path" ]] || [[ ! -s "$path" ]]; then
            log "  repairing: $f"
            repaired=1
            rm -rf "$path"
            mkdir -p "$(dirname "$path")"
            if ! curl -fsSL --retry 3 --retry-delay 2 \
                 -o "$path" "$base_url/$f" >>"$LOG_FILE" 2>&1; then
                log "  ERROR: failed to repair $f"
                return 1
            fi
            [[ "$f" == *.sh ]] && chmod +x "$path" 2>/dev/null || true
        fi
    done
    [[ $repaired -eq 1 ]] && log "Supabase: volumes repaired" \
                           || log "Supabase: volumes OK"
    return 0
}

# Глобальный массив для флагов compose — объявляем заранее
declare -a _SUPABASE_CF=()

supabase_start_staged() {
    # Использует глобальный массив _SUPABASE_CF
    local total=7

    info_box "Supabase (1/$total)" "Запуск PostgreSQL..." 1
    log "Supabase: [1/$total] db"
    docker compose -p supabase "${_SUPABASE_CF[@]}" up -d db \
        >>"$LOG_FILE" 2>&1 || return 1
    supabase_wait_pg_ready supabase-db 120
    supabase_wait_healthy  supabase-db 60 || \
        log "  WARN: db not fully healthy, continuing"

    info_box "Supabase (2/$total)" "Запуск аналитики..." 1
    log "Supabase: [2/$total] analytics"
    docker compose -p supabase "${_SUPABASE_CF[@]}" up -d analytics \
        >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-analytics 120 || \
        log "  WARN: analytics slow"

    info_box "Supabase (3/$total)" "Запуск Vector..." 1
    log "Supabase: [3/$total] vector"
    docker compose -p supabase "${_SUPABASE_CF[@]}" up -d --force-recreate vector \
        >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-vector 90 || \
        log "  WARN: vector slow"

    info_box "Supabase (4/$total)" "Запуск сервисов БД..." 1
    log "Supabase: [4/$total] meta/auth/rest/storage/realtime/functions/imgproxy/supavisor"
    docker compose -p supabase "${_SUPABASE_CF[@]}" up -d \
        meta auth rest storage realtime functions imgproxy supavisor \
        >>"$LOG_FILE" 2>&1 || true
    sleep 10
    local s
    for s in supabase-auth supabase-rest supabase-storage \
              supabase-meta supabase-realtime; do
        supabase_wait_healthy "$s" 60 || log "  WARN: $s not healthy"
    done

    info_box "Supabase (5/$total)" "Запуск Kong..." 1
    log "Supabase: [5/$total] kong"
    docker compose -p supabase "${_SUPABASE_CF[@]}" up -d --force-recreate kong \
        >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-kong 60 || \
        log "  WARN: kong slow"

    info_box "Supabase (6/$total)" "Запуск Studio..." 1
    log "Supabase: [6/$total] studio"
    docker compose -p supabase "${_SUPABASE_CF[@]}" up -d studio \
        >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-studio 90 || \
        log "  WARN: studio slow"

    info_box "Supabase (7/$total)" "Стабилизация..." 3
    sleep 12

    # Перезапуск проблемных контейнеров
    local svc st
    for svc in supabase-vector supabase-kong; do
        st=$(docker inspect --format '{{.State.Status}}' "$svc" 2>/dev/null \
             || echo "missing")
        if [[ "$st" != "running" ]]; then
            log "  retrying ${svc#supabase-}..."
            docker compose -p supabase "${_SUPABASE_CF[@]}" \
                up -d --force-recreate "${svc#supabase-}" \
                >>"$LOG_FILE" 2>&1 || true
            sleep 5
        fi
    done
    return 0
}

supabase_connect_network() {
    local c
    docker ps --filter "name=supabase-" --format "{{.Names}}" 2>/dev/null \
    | while IFS= read -r c; do
        docker network connect internal_network "$c" 2>/dev/null || true
    done
    docker ps --filter "name=realtime-dev" --format "{{.Names}}" 2>/dev/null \
    | while IFS= read -r c; do
        docker network connect internal_network "$c" 2>/dev/null || true
    done
    log "Supabase: connected to internal_network"
}

supabase_verify() {
    local critical=(supabase-db supabase-kong supabase-studio \
                    supabase-auth supabase-rest)
    local missing=() svc st
    for svc in "${critical[@]}"; do
        st=$(docker inspect --format '{{.State.Status}}' "$svc" 2>/dev/null \
             || echo "missing")
        [[ "$st" != "running" ]] && missing+=("$svc:$st")
    done
    if [[ ${#missing[@]} -eq 0 ]]; then
        log "Supabase verify OK"
        return 0
    fi
    log "Supabase verify FAILED: ${missing[*]}"
    return 1
}

setup_supabase() {
    is_selected "supabase" || return 0
    log_section "Supabase setup"

    pushd "$SETUP_DIR" >/dev/null || return 1

    if ! supabase_download; then
        popd >/dev/null || true
        dialog --title "Ошибка Supabase" \
            --msgbox "Не удалось скачать Supabase.\nЛог: $LOG_FILE" 9 60
        return 1
    fi

    cd supabase-docker || { popd >/dev/null || true; return 1; }

    # Override: порты через override (не патчим оригинальный compose)
    cat > docker-compose.override.yml <<OVERRIDE_EOF
services:
  realtime:
    healthcheck:
      test: "curl -sSfL --head -o /dev/null http://localhost:4000/ || exit 1"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
  studio:
    ports:
      - "${SUPABASE_PORT_STUDIO}:3000"
  db:
    ports:
      - "${SUPABASE_PORT_PG}:5432"
  kong:
    ports:
      - "${SUPABASE_PORT_API}:8000"
      - "8443:8443"
  supavisor:
    ports:
      - "${SUPABASE_PORT_POOLER}:6543"
OVERRIDE_EOF
    log "Supabase: override written"

    # Глобальный массив флагов compose — безопасная передача имён файлов
    _SUPABASE_CF=(-f docker-compose.yml -f docker-compose.override.yml)

    # Новая установка?
    local is_new=0
    if [[ ! -f .env ]] || ! grep -q "^ANON_KEY=" .env 2>/dev/null; then
        is_new=1
        cp .env.example .env

        local now
        now=$(date +%s)

        # Генерируем валидные JWT через HMAC-SHA256
        local anon_payload svc_payload
        anon_payload=$(printf '{"role":"anon","iss":"supabase","iat":%d,"exp":1799535600}' "$now")
        svc_payload=$(printf '{"role":"service_role","iss":"supabase","iat":%d,"exp":1799535600}' "$now")

        local ANON_KEY SERVICE_ROLE_KEY
        ANON_KEY=$(        _jwt_sign "$anon_payload" "$JWT_SECRET")
        SERVICE_ROLE_KEY=$(_jwt_sign "$svc_payload"  "$JWT_SECRET")

        local SECRET_KEY_BASE VAULT_ENC_KEY PG_META_CRYPTO_KEY
        local S3_PROTOCOL_ACCESS_KEY_ID S3_PROTOCOL_ACCESS_KEY_SECRET
        local LOGFLARE_PUBLIC_ACCESS_TOKEN LOGFLARE_PRIVATE_ACCESS_TOKEN
        local DASHBOARD_USERNAME DASHBOARD_PASSWORD

        # SECRET_KEY_BASE для Elixir/Phoenix — минимум 64 байта
        SECRET_KEY_BASE=$(openssl rand -hex 64)
        VAULT_ENC_KEY=$(openssl rand -hex 32)
        PG_META_CRYPTO_KEY=$(openssl rand -hex 32)
        S3_PROTOCOL_ACCESS_KEY_ID=$(openssl rand -hex 16)
        S3_PROTOCOL_ACCESS_KEY_SECRET=$(openssl rand -hex 32)
        LOGFLARE_PUBLIC_ACCESS_TOKEN=$(openssl rand -hex 32)
        LOGFLARE_PRIVATE_ACCESS_TOKEN=$(openssl rand -hex 32)
        DASHBOARD_USERNAME="supabase"
        DASHBOARD_PASSWORD=$(openssl rand -hex 16)

        local v
        for v in ANON_KEY SERVICE_ROLE_KEY SECRET_KEY_BASE VAULT_ENC_KEY \
                 PG_META_CRYPTO_KEY S3_PROTOCOL_ACCESS_KEY_ID \
                 S3_PROTOCOL_ACCESS_KEY_SECRET LOGFLARE_PUBLIC_ACCESS_TOKEN \
                 LOGFLARE_PRIVATE_ACCESS_TOKEN DASHBOARD_USERNAME \
                 DASHBOARD_PASSWORD; do
            inject_env .env "$v" "${!v}"
        done

        log "Supabase: credentials → $DASHBOARD_USERNAME / $DASHBOARD_PASSWORD"
        printf '%s:%s\n' "$DASHBOARD_USERNAME" "$DASHBOARD_PASSWORD" \
            > "$SETUP_DIR/supabase_credentials.txt"
        chmod 600 "$SETUP_DIR/supabase_credentials.txt"
    fi

    # Обновляем общие параметры (и при новой, и при обновлении)
    [[ -n "$JWT_SECRET" ]] && inject_env .env JWT_SECRET "$(env_esc "$JWT_SECRET")"
    [[ -n "$PGPASSWORD" ]] && inject_env .env POSTGRES_PASSWORD "$(env_esc "$PGPASSWORD")"

    local scheme="http"
    [[ "$SUPABASE_HTTPS" == "1" ]] && scheme="https"
    local ip
    ip=$(hostname -I | awk '{print $1}')

    if [[ -n "$SUPABASE_DOMAIN" ]]; then
        inject_env .env API_EXTERNAL_URL    "$(env_esc "${scheme}://${SUPABASE_DOMAIN}")"
        inject_env .env SITE_URL            "$(env_esc "${scheme}://${SUPABASE_DOMAIN}")"
        inject_env .env SUPABASE_PUBLIC_URL "$(env_esc "${scheme}://${SUPABASE_DOMAIN}")"
    else
        inject_env .env API_EXTERNAL_URL    "$(env_esc "http://${ip}:${SUPABASE_PORT_API}")"
        inject_env .env SITE_URL            "$(env_esc "http://${ip}:${SUPABASE_PORT_STUDIO}")"
        inject_env .env SUPABASE_PUBLIC_URL "$(env_esc "http://${ip}:${SUPABASE_PORT_API}")"
    fi

    supabase_validate_volumes || {
        popd >/dev/null || true
        dialog --title "Ошибка" \
            --msgbox "Ошибка подготовки volumes.\nЛог: $LOG_FILE" 7 60
        return 1
    }

    info_box "Supabase" "Скачивание образов (5-15 мин)..." 1
    docker compose -p supabase "${_SUPABASE_CF[@]}" pull \
        >>"$LOG_FILE" 2>&1 || \
        log "WARN: pull errors, continuing"

    if [[ $is_new -eq 0 ]]; then
        log "Supabase: existing install — restarting"
        docker compose -p supabase "${_SUPABASE_CF[@]}" down \
            >>"$LOG_FILE" 2>&1 || true
        sleep 3
    fi

    supabase_start_staged
    supabase_connect_network

    local studio_url="http://${ip}:${SUPABASE_PORT_STUDIO}"
    [[ -n "$SUPABASE_DOMAIN" ]] && studio_url="${scheme}://${SUPABASE_DOMAIN}"

    if supabase_verify; then
        local creds=""
        [[ -f "$SETUP_DIR/supabase_credentials.txt" ]] && \
            creds=$(<"$SETUP_DIR/supabase_credentials.txt")
        dialog --title "Supabase запущен" --msgbox \
"Supabase установлен!

  Studio:     ${studio_url}
  API:        http://${ip}:${SUPABASE_PORT_API}
  PostgreSQL: ${ip}:${SUPABASE_PORT_PG}
  Pooler:     ${ip}:${SUPABASE_PORT_POOLER}

  Логин: ${creds:-см. supabase_credentials.txt}" 16 70
    else
        dialog --title "Внимание" --msgbox \
"Supabase запустился частично.
Проверьте: docker ps | grep supabase
Лог: $LOG_FILE" 9 60
    fi

    popd >/dev/null || true
}

