    local ok=0

    if command -v curl &>/dev/null; then
        log "  attempt 1: curl codeload"
        rm -f "$archive"
        if timeout 600 curl -fSL --retry 3 --retry-delay 5 \
            -o "$archive" \
            "https://codeload.github.com/supabase/supabase/tar.gz/refs/heads/master" \
            >>"$LOG_FILE" 2>&1; then
            ok=1
        fi
    fi
    if [[ $ok -eq 0 ]] && command -v wget &>/dev/null; then
        log "  attempt 2: wget"
        rm -f "$archive"
        if timeout 600 wget -q --tries=3 --timeout=60 \
            -O "$archive" \
            "https://codeload.github.com/supabase/supabase/tar.gz/refs/heads/master" \
            >>"$LOG_FILE" 2>&1; then
            ok=1
        fi
    fi
    if [[ $ok -eq 0 ]]; then
        log "  attempt 3: git clone"
        rm -rf "$SETUP_DIR/supabase-git"
        if command -v git &>/dev/null && \
           timeout 600 git clone --depth 1 https://github.com/supabase/supabase \
               "$SETUP_DIR/supabase-git" >>"$LOG_FILE" 2>&1; then
            if [[ -d "$SETUP_DIR/supabase-git/docker" ]]; then
                mv "$SETUP_DIR/supabase-git/docker" "$SETUP_DIR/supabase-docker"
                rm -rf "$SETUP_DIR/supabase-git"
                return 0
            fi
        fi
    fi

    if [[ $ok -eq 1 ]] && [[ -f "$archive" ]]; then
        log "  extracting..."
        mkdir -p "$SETUP_DIR/supabase-tmp"
        if tar -xzf "$archive" -C "$SETUP_DIR/supabase-tmp" >>"$LOG_FILE" 2>&1; then
            local d
            d=$(ls "$SETUP_DIR/supabase-tmp/" 2>/dev/null | head -1)
            if [[ -n "$d" ]] && [[ -d "$SETUP_DIR/supabase-tmp/$d/docker" ]]; then
                mv "$SETUP_DIR/supabase-tmp/$d/docker" "$SETUP_DIR/supabase-docker"
                rm -rf "$SETUP_DIR/supabase-tmp" "$archive"
                return 0
            fi
        fi
        rm -rf "$SETUP_DIR/supabase-tmp" "$archive"
    fi

    return 1
}

supabase_start_staged() {
    local total_stages=6
    local stage=0

    stage=1
    info_box "Supabase ($stage/$total_stages)" "Запуск PostgreSQL..." 1
    log "Supabase stage $stage: db"
    docker compose -p supabase up -d db >>"$LOG_FILE" 2>&1 || return 1
    supabase_wait_pg_ready supabase-db 120
    supabase_wait_healthy supabase-db 60 || log "  WARN: db not fully healthy, continuing"

    stage=2
    info_box "Supabase ($stage/$total_stages)" "Запуск Vector (логи)..." 1
    log "Supabase stage $stage: vector"
    docker compose -p supabase up -d vector >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-vector 60 || log "  WARN: vector slow"

    stage=3
    info_box "Supabase ($stage/$total_stages)" "Запуск аналитики (Logflare)..." 1
    log "Supabase stage $stage: analytics"
    docker compose -p supabase up -d analytics >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-analytics 120 || log "  WARN: analytics slow"

    stage=4
    info_box "Supabase ($stage/$total_stages)" "Запуск сервисов БД..." 1
    log "Supabase stage $stage: meta/auth/rest/storage/realtime/functions/imgproxy/supavisor"
    docker compose -p supabase up -d \
        meta auth rest storage realtime functions imgproxy supavisor \
        >>"$LOG_FILE" 2>&1 || true
    sleep 10
    local s
    for s in supabase-auth supabase-rest supabase-storage supabase-meta supabase-realtime; do
        supabase_wait_healthy "$s" 60 || log "  WARN: $s not fully healthy"
    done

    stage=5
    info_box "Supabase ($stage/$total_stages)" "Запуск API Gateway (Kong)..." 1
    log "Supabase stage $stage: kong"
    docker compose -p supabase up -d kong >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-kong 60 || log "  WARN: kong slow"

    stage=6
    info_box "Supabase ($stage/$total_stages)" "Запуск Studio (UI)..." 1
    log "Supabase stage $stage: studio"
    docker compose -p supabase up -d studio >>"$LOG_FILE" 2>&1 || true
    supabase_wait_healthy supabase-studio 90 || log "  WARN: studio slow"

    info_box "Supabase" "Стабилизация (15 сек)..." 1
    sleep 15
    return 0
}

supabase_connect_network() {
    local c
    docker ps --filter "name=supabase-" --format "{{.Names}}" 2>/dev/null \
    | while IFS= read -r c; do
        docker network connect internal_network "$c" 2>/dev/null || true
    done
    log "Supabase containers connected to internal_network"
}

supabase_verify() {
    local critical=(supabase-db supabase-kong supabase-studio supabase-auth supabase-rest)
    local missing=()
    local svc st
    for svc in "${critical[@]}"; do
        st=$(docker inspect --format '{{.State.Status}}' "$svc" 2>/dev/null || echo "missing")
        [[ "$st" != "running" ]] && missing+=("$svc:$st")
    done
    if [[ ${#missing[@]} -eq 0 ]]; then
        log "Supabase verify OK"
        return 0
    fi
    log "Supabase verify FAILED: ${missing[*]}"
    return 1
}

setup_supabase() {
    is_selected "supabase" || return 0
    log_section "Supabase setup"

    pushd "$SETUP_DIR" >/dev/null || return 1

    if ! supabase_download; then
        popd >/dev/null
        dialog --title "Ошибка Supabase" \
            --msgbox "Не удалось скачать Supabase.\nПроверьте интернет/доступ к GitHub.\nЛог: $LOG_FILE" 9 60
        return 1
    fi

    cd supabase-docker || { popd >/dev/null; return 1; }

    cat > docker-compose.override.yml <<'OVR'
services:
  realtime:
    healthcheck:
      test: ["CMD-SHELL", "curl -sSfL --head -o /dev/null http://localhost:4000/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
OVR

    local is_new=0
    if [[ ! -f .env ]] || ! grep -q "^ANON_KEY=" .env 2>/dev/null; then
        is_new=1
        cp .env.example .env
        local ANON_KEY SERVICE_ROLE_KEY SECRET_KEY_BASE VAULT_ENC_KEY
        local DASHBOARD_USERNAME DASHBOARD_PASSWORD
        ANON_KEY=$(openssl rand -hex 32)
        SERVICE_ROLE_KEY=$(openssl rand -hex 32)
        SECRET_KEY_BASE=$(openssl rand -hex 32)
        VAULT_ENC_KEY=$(openssl rand -hex 32)
        DASHBOARD_USERNAME="supabase"
        DASHBOARD_PASSWORD=$(openssl rand -hex 12)
        local v
        for v in ANON_KEY SERVICE_ROLE_KEY SECRET_KEY_BASE VAULT_ENC_KEY \
                 DASHBOARD_USERNAME DASHBOARD_PASSWORD; do
            inject_env .env "$v" "${!v}"
        done
        log "Supabase: dashboard credentials → user=$DASHBOARD_USERNAME pass=$DASHBOARD_PASSWORD"
        echo "$DASHBOARD_USERNAME:$DASHBOARD_PASSWORD" > "$SETUP_DIR/supabase_credentials.txt"
        chmod 600 "$SETUP_DIR/supabase_credentials.txt"
    fi

    [[ -n "$JWT_SECRET" ]] && inject_env .env JWT_SECRET "$(env_esc "$JWT_SECRET")"
    [[ -n "$PGPASSWORD" ]] && inject_env .env POSTGRES_PASSWORD "$(env_esc "$PGPASSWORD")"

    local scheme="http"
    [[ "$SUPABASE_HTTPS" == "1" ]] && scheme="https"
    if [[ -n "$SUPABASE_DOMAIN" ]]; then
        inject_env .env API_EXTERNAL_URL    "$(env_esc "${scheme}://${SUPABASE_DOMAIN}")"
        inject_env .env SITE_URL            "$(env_esc "${scheme}://${SUPABASE_DOMAIN}")"
        inject_env .env SUPABASE_PUBLIC_URL "$(env_esc "${scheme}://${SUPABASE_DOMAIN}")"
    else
        local ip
        ip=$(hostname -I | awk '{print $1}')
        inject_env .env API_EXTERNAL_URL    "$(env_esc "http://${ip}:${SUPABASE_PORT_API}")"
        inject_env .env SITE_URL            "$(env_esc "http://${ip}:${SUPABASE_PORT_STUDIO}")"
        inject_env .env SUPABASE_PUBLIC_URL "$(env_esc "http://${ip}:${SUPABASE_PORT_API}")"
    fi

    supabase_patch_compose

    info_box "Supabase" "Скачивание образов (5-15 мин)..." 1
    log "Supabase: docker compose pull..."
    docker compose -p supabase pull >>"$LOG_FILE" 2>&1 || \
        log "WARN: some images failed to pull, will retry on up"

    if [[ $is_new -eq 0 ]]; then
        log "Supabase: existing installation — restarting"
        docker compose -p supabase down >>"$LOG_FILE" 2>&1 || true
        sleep 3
    fi

    supabase_start_staged
    supabase_connect_network

    if supabase_verify; then
        local ip
        ip=$(hostname -I | awk '{print $1}')
        local studio_url="http://${ip}:${SUPABASE_PORT_STUDIO}"
        [[ -n "$SUPABASE_DOMAIN" ]] && studio_url="${scheme}://${SUPABASE_DOMAIN}"
        local creds=""
        [[ -f "$SETUP_DIR/supabase_credentials.txt" ]] && \
            creds=$(<"$SETUP_DIR/supabase_credentials.txt")
        dialog --title "Supabase запущен" --msgbox \
"Supabase успешно установлен!

  Studio (UI):  ${studio_url}
  API Gateway:  http://${ip}:${SUPABASE_PORT_API}
  PostgreSQL:   ${ip}:${SUPABASE_PORT_PG}
  Pooler:       ${ip}:${SUPABASE_PORT_POOLER}

  Логин Studio: ${creds:-см. .env}

Для подключения n8n используйте:
  host=${ip} port=${SUPABASE_PORT_PG}
  user=postgres password=<JWT_SECRET в params.env>" 18 70
    else
        dialog --title "Внимание" --msgbox \
"Supabase запустился частично.
Проверьте: docker ps | grep supabase
Лог: $LOG_FILE" 9 60
    fi

    popd >/dev/null
}

