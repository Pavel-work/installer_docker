        printf '    volumes:\n'                                         >> docker-compose.yml
        printf '      - n8n_data:/home/node/.n8n\n'                    >> docker-compose.yml
        printf '    networks:\n'                                         >> docker-compose.yml
        printf '      - internal_network\n\n'                           >> docker-compose.yml
    fi

    popd >/dev/null 2>&1 || true
    log "docker-compose.yml generated"
}

###############################################################################
#  СОЗДАНИЕ БД n8n
###############################################################################
create_n8n_database() {
    local wait_sec=0
    log "n8n DB: waiting for postgres..."
    while [[ $wait_sec -lt 90 ]]; do
        if docker exec -T postgres \
           pg_isready -U admin -h localhost &>/dev/null; then
            log "  ✓ postgres ready (${wait_sec}s)"
            break
        fi
        sleep 3; wait_sec=$((wait_sec + 3))
    done

    local attempt check rc result rc_c
    for attempt in 1 2 3; do
        rc=0
        check=$(docker exec -T postgres \
            psql -U admin -h localhost -d appdb -tA \
            -c "SELECT 1 FROM pg_database WHERE datname='n8n';" \
            2>&1) || rc=$?
        log "n8n DB check #$attempt: rc=$rc"
        if [[ "$(printf '%s' "$check" | tr -d '[:space:]')" == "1" ]]; then
            log "n8n DB exists"
            return 0
        fi
        rc_c=0
        result=$(docker exec -T postgres \
            psql -U admin -h localhost -d appdb \
            -c "CREATE DATABASE n8n;" 2>&1) || rc_c=$?
        log "n8n DB create #$attempt: rc=$rc_c"
        if [[ $rc_c -eq 0 ]] || \
           printf '%s' "$result" | grep -qi "already\|created"; then
            log "n8n DB created"
            return 0
        fi
        sleep 5
    done
    log "WARN: n8n DB creation failed, n8n will retry on start"
    return 0
}

###############################################################################
#  ЗАПУСК КОНТЕЙНЕРОВ
###############################################################################
start_containers() {
    pushd "$SETUP_DIR" >/dev/null || return 1

    if [[ ! -f docker-compose.yml ]]; then
        popd >/dev/null 2>&1 || true
        return 0
    fi

    log_section "Starting containers"

    if is_selected "postgres"; then
        info_box "Запуск" "1/3: PostgreSQL..." 1
        docker compose up -d postgres >>"$LOG_FILE" 2>&1

        local wait_sec=0
        while [[ $wait_sec -lt 60 ]]; do
            local hs
            hs=$(docker inspect --format '{{.State.Health.Status}}' \
                 postgres 2>/dev/null || echo "")
            [[ "$hs" == "healthy" ]] && break
            sleep 2; wait_sec=$((wait_sec + 2))
        done

        if is_selected "n8n" && [[ "$N8N_DB_POSTGRES" == "1" ]]; then
            info_box "Запуск" "2/3: Создание БД n8n..." 1
            create_n8n_database
        fi

        info_box "Запуск" "3/3: Все контейнеры..." 1
        docker compose up -d >>"$LOG_FILE" 2>&1
    else
        info_box "Запуск" "Запуск контейнеров..." 1
        docker compose up -d >>"$LOG_FILE" 2>&1
    fi

    sleep 10
    log "Containers:"
    docker ps --format "  {{.Names}}: {{.Status}}" >>"$LOG_FILE" 2>&1

    local running
    running=$(docker ps \
        --filter "label=com.docker.compose.project" \
        --format '{{.Names}}' 2>/dev/null | wc -l)

    popd >/dev/null 2>&1 || true

    if [[ $running -eq 0 ]]; then
        dialog --title "Ошибка" \
            --msgbox "Контейнеры не запустились.\nЛог: $LOG_FILE" 8 60
        return 1
    fi
    log "Started: $running containers"
}

