supabase_wait_healthy() {
    local container="$1" max_wait="${2:-180}"
    local elapsed=0 status=""
    while [[ $elapsed -lt $max_wait ]]; do
        status=$(docker inspect --format '{{.State.Health.Status}}' "$container" 2>/dev/null || echo "missing")
        case "$status" in
            healthy) log "  ✓ $container healthy (${elapsed}s)"; return 0 ;;
            missing) log "  ✗ $container missing"; return 1 ;;
        esac
        sleep 3
        elapsed=$((elapsed + 3))
    done
    log "  ⚠ $container timeout after ${max_wait}s (status: $status)"
    return 1
}

supabase_wait_pg_ready() {
    local container="$1" max_wait="${2:-120}"
    local elapsed=0
    while [[ $elapsed -lt $max_wait ]]; do
        if docker exec -T "$container" pg_isready -U postgres -h localhost &>/dev/null; then
            log "  ✓ $container accepting connections (${elapsed}s)"
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    log "  ⚠ $container not accepting connections after ${max_wait}s"
    return 1
}

supabase_patch_compose() {
    local f="docker-compose.yml"
    [[ ! -f "$f" ]] && { log "ERROR: $f not found"; return 1; }

    [[ ! -f "${f}.orig" ]] && cp "$f" "${f}.orig"
    cp "${f}.orig" "$f"

    sed -i.bak \
        -e "s|\${STUDIO_PORT}:3000|${SUPABASE_PORT_STUDIO}:3000|g" \
        -e "s|\${KONG_HTTP_PORT}:8000|${SUPABASE_PORT_API}:8000|g" \
        -e "s|\${POSTGRES_PORT}:5432|${SUPABASE_PORT_PG}:5432|g" \
        -e "s|\${POOLER_PROXY_PORT_TRANSACTION}:6543|${SUPABASE_PORT_POOLER}:6543|g" \
        "$f"
    rm -f "${f}.bak"

    if ! grep -q "internal_network" "$f"; then
        cat >> "$f" <<'NETEOF'

networks:
  default:
    name: supabase_default
  internal_network:
    external: true
NETEOF
    fi

    log "Supabase: ports patched (Studio=$SUPABASE_PORT_STUDIO, DB=$SUPABASE_PORT_PG, API=$SUPABASE_PORT_API, Pooler=$SUPABASE_PORT_POOLER)"
}

