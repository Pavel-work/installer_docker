setup_cloudflared() {
    is_selected "cloudflared" || return 0
    log_section "Cloudflare Tunnel setup"
    mkdir -p "$SETUP_DIR/cloudflared"
    chmod 700 "$SETUP_DIR/cloudflared"

    # Удаляем старые credentials кроме текущего tunnel
    find "$SETUP_DIR/cloudflared" -maxdepth 1 -name "*.json" \
        ! -name "${CLOUDFLARE_TUNNEL_ID}.json" -delete 2>/dev/null || true

    if [[ "$CLOUDFLARE_MODE" == "config" ]]; then
        cf_generate_config
    else
        rm -f "$SETUP_DIR/cloudflared/config.yml" 2>/dev/null || true
    fi
    log "Cloudflared: mode=$CLOUDFLARE_MODE"
}

cf_generate_config() {
    local cfg="$SETUP_DIR/cloudflared/config.yml"
    local creds="$SETUP_DIR/cloudflared/${CLOUDFLARE_TUNNEL_ID}.json"

    cat > "$creds" <<EOF
{
  "AccountTag":   "${CLOUDFLARE_ACCOUNT_TAG}",
  "TunnelID":     "${CLOUDFLARE_TUNNEL_ID}",
  "TunnelSecret": "${CLOUDFLARE_TUNNEL_SECRET}"
}
EOF
    chmod 600 "$creds"

    local has_routes=0
    {
        printf 'tunnel: %s\n' "$CLOUDFLARE_TUNNEL_ID"
        printf 'credentials-file: /etc/cloudflared/%s.json\n' "$CLOUDFLARE_TUNNEL_ID"
        printf 'no-autoupdate: true\n\n'
        printf 'ingress:\n'

        local r host service
        local -a route_arr
        IFS=',' read -ra route_arr <<< "$CLOUDFLARE_ROUTES"
        for r in "${route_arr[@]}"; do
            [[ -z "$r" ]] && continue
            cf_route_to_host_service "$r" host service
            [[ -z "$host" ]] && continue
            has_routes=1
            printf '  - hostname: %s\n    service: %s\n' "$host" "$service"
        done
        printf '  - service: http_status:404\n'
    } > "$cfg"
    chmod 600 "$cfg"
    [[ $has_routes -eq 0 ]] && log "WARN: cloudflared config has no routes"
    log "Cloudflared config.yml generated"
}

verify_cloudflared() {
    is_selected "cloudflared" || return 0
    log "Verifying cloudflared..."
    local i logs=""
    for i in 1 2 3 4 5; do
        sleep 3
        if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^cloudflared$'; then
            log "cloudflared container not running"
            break
        fi
        logs=$(docker logs cloudflared 2>&1 | tail -40)
        if printf '%s' "$logs" | grep -qiE \
           "Registered tunnel connection|connIndex.*Connected"; then
            log "Cloudflared: connected (attempt $i)"
            return 0
        fi
    done

    log "Cloudflared verify FAILED"
    printf '%s\n' "$logs" >>"$LOG_FILE"

    local lf
    lf=$(_mktemp)
    {
        printf 'Cloudflared не подтвердил подключение.\n\n'
        printf 'Причины:\n'
        printf '  • Неверный токен/credentials\n'
        printf '  • Нет интернета\n'
        printf '  • Тоннель удалён в dashboard\n\n'
        printf 'Последние логи:\n────────────\n'
        printf '%s\n' "$logs"
    } > "$lf"
    dialog --title "Cloudflare — внимание" --textbox "$lf" 22 78
    return 1
}

