save_params() {
    local f="$PARAMS_FILE.tmp"
    {
        local k
        for k in "${!_PM[@]}"; do
            printf '%s="%s"\n' "${_PM[$k]}" "$(b64enc "${!k:-}")"
        done
    } > "$f"
    mv "$f" "$PARAMS_FILE"
    chmod 600 "$PARAMS_FILE"
}

