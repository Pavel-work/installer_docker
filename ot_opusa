#!/bin/bash
set -uo pipefail
###############################################################################
#  Джентльменский набор — установщик сервисов v5.1
#  Полный объединённый скрипт
###############################################################################

readonly STATE_DIR="/root/.server-setup-state"
readonly STATE_FILE="$STATE_DIR/state.cfg"
readonly SELECTED_FILE="$STATE_DIR/selected_services.cfg"
readonly PARAMS_FILE="$STATE_DIR/params.env"
readonly SETUP_DIR="/root/server-setup"
readonly LOG_FILE="/var/log/install.log"
readonly REAL_USER="${SUDO_USER:-${USER:-root}}"

readonly DLG_H=22
readonly DLG_W=72

declare -a SELECTED_ARRAY=()
declare -a _MKTEMPS=()

mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")" 2>/dev/null || true
touch "$LOG_FILE" 2>/dev/null || true

TMP=$(mktemp); _MKTEMPS+=("$TMP")
TMP2=$(mktemp); _MKTEMPS+=("$TMP2")

_mktemp() {
    local f
    f=$(mktemp "$@")
    _MKTEMPS+=("$f")
    printf '%s' "$f"
}

cleanup() {
    local f
    for f in "${_MKTEMPS[@]+"${_MKTEMPS[@]}"}"; do
        rm -f "$f" 2>/dev/null || true
    done
}
trap cleanup EXIT INT TERM

log() {
    printf '%s  %s\n' "$(date '+%F %T')" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

log_section() {
    log "========================================================"
    log "  $*"
    log "========================================================"
}

env_esc() {
    local v="${1:-}"
    local bt='`'
    v="${v//\\/\\\\}"
    v="${v//\"/\\\"}"
    v="${v//\$/\\\$}"
    v="${v//$bt/\\$bt}"
    v="${v//$'\n'/\\n}"
    printf '"%s"' "$v"
}

yaml_sq_esc() {
    local v="${1:-}"
    v="${v//\'/\'\'}"
    printf '%s' "$v"
}

compose_esc() {
    local v="${1:-}"
    v="${v//\\/\\\\}"
    v="${v//\"/\\\"}"
    printf '%s' "$v"
}

inject_env() {
    local file="$1" key="$2" value="$3"
    local tmp found=0
    [[ ! -f "$file" ]] && touch "$file"
    tmp=$(_mktemp)
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "${key}="* ]]; then
            printf '%s=%s\n' "$key" "$value"
            found=1
        else
            printf '%s\n' "$line"
        fi
    done < "$file" > "$tmp"
    [[ $found -eq 0 ]] && printf '%s=%s\n' "$key" "$value" >> "$tmp"
    mv "$tmp" "$file"
}

b64enc() {
    [[ -z "${1:-}" ]] && { printf ''; return 0; }
    local r
    if r=$(printf '%s' "$1" | base64 -w0 2>/dev/null) && [[ -n "$r" ]]; then
        printf '%s' "$r"
    elif r=$(printf '%s' "$1" | base64 2>/dev/null | tr -d '\n'); then
        printf '%s' "$r"
    else
        printf ''
    fi
}

b64dec() {
    [[ -z "${1:-}" ]] && { printf ''; return 0; }
    printf '%s' "$1" | base64 -d 2>/dev/null || printf ''
}

load_param_b64() {
    local file="$1" key="$2"
    local line val
    line=$(grep "^${key}=" "$file" 2>/dev/null | head -n1) || line=""
    [[ -z "$line" ]] && return 1
    val="${line#*=}"
    val="${val#\"}"; val="${val%\"}"
    val="${val#\'}"; val="${val%\'}"
    printf '%s' "$val"
}

port_in_use() {
    local port="$1"
    if command -v ss &>/dev/null; then
        ss -tuln 2>/dev/null | grep -qE ":${port}\b"
    elif command -v netstat &>/dev/null; then
        netstat -tuln 2>/dev/null | grep -qE ":${port}\b"
    else
        (echo >/dev/tcp/127.0.0.1/${port}) 2>/dev/null
    fi
}

check_port() {
    local port="$1"
    if port_in_use "$port"; then
        if dialog --title "Порт занят" \
            --yes-label "Другой порт" --no-label "Пропустить" \
            --yesno "Порт $port уже используется.\nПопробовать другой?" 8 55; then
            return 1
        fi
    fi
    return 0
}

is_selected() {
    local s
    for s in "${SELECTED_ARRAY[@]+"${SELECTED_ARRAY[@]}"}"; do
        [[ "$s" == "$1" ]] && return 0
    done
    return 1
}

save_state() { printf '%s' "$1" >"$STATE_FILE"; }
get_state()  { [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "start"; }

save_selected_services() {
    if [[ ${#SELECTED_ARRAY[@]} -gt 0 ]]; then
        printf '%s\n' "${SELECTED_ARRAY[@]}" >"$SELECTED_FILE"
    else
        : >"$SELECTED_FILE"
    fi
}

load_selected_services() {
    SELECTED_ARRAY=()
    [[ ! -s "$SELECTED_FILE" ]] && return 0
    mapfile -t SELECTED_ARRAY < "$SELECTED_FILE"
    local c=() i
    for i in "${SELECTED_ARRAY[@]+"${SELECTED_ARRAY[@]}"}"; do
        i="${i//\"/}"; i="${i// /}"; i="${i//$'\r'/}"
        [[ -n "$i" ]] && c+=("$i")
    done
    SELECTED_ARRAY=("${c[@]+"${c[@]}"}")
}

