generate_compose_file() {
    pushd "$SETUP_DIR" >/dev/null || return 1

    local has=0 s
    for s in postgres qdrant ollama nginx_proxy portainer n8n apache cloudflared; do
        is_selected "$s" && { has=1; break; }
    done
    if [[ $has -eq 0 ]]; then
        rm -f docker-compose.yml
        popd >/dev/null 2>&1 || true
        return 0
    fi

    # Пароль PG для YAML single-quoted scalar
    local pg_sq
    pg_sq=$(yaml_sq_esc "$PGPASSWORD")

    # Путь Apache для YAML double-quoted scalar
    local www
    www=$(compose_esc "$APACHE_WWW_PATH")

    # WEBHOOK_URL для n8n
    local webhook_url
    if [[ -n "$DOMAIN" ]]; then
        if [[ "$DOMAIN_HTTPS" == "1" ]]; then
            webhook_url="https://${DOMAIN}/"
        else
            webhook_url="http://${DOMAIN}:${N8N_PORT}/"
        fi
    else
        local ip
        ip=$(hostname -I | awk '{print $1}')
        webhook_url="http://${ip}:${N8N_PORT}/"
    fi
    local webhook_sq
    webhook_sq=$(yaml_sq_esc "$webhook_url")

    # Записываем в файл через printf — без heredoc интерполяции
    {
        printf 'networks:\n'
        printf '  internal_network:\n'
        printf '    external: true\n\n'
        printf 'volumes:\n'
        is_selected "postgres"    && printf '  postgres_data:\n'
        is_selected "qdrant"      && printf '  qdrant_storage:\n'
