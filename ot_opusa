###############################################################################
#  ФИНАЛЬНАЯ СВОДКА
###############################################################################
show_final_summary() {
    local ip; ip=$(hostname -I | awk '{print $1}')
    local sf="$STATE_DIR/final_summary.txt"
    local running
    running=$(docker ps --format "{{.Names}}: {{.Status}}" 2>/dev/null) \
        || running=""

    mkdir -p "$STATE_DIR"
    {
        printf '════════════════════════════════════════════\n'
        printf '        УСТАНОВКА ЗАВЕРШЕНА\n'
        printf '════════════════════════════════════════════\n\n'
        printf '  IP: %s\n\n' "$ip"
        printf '── Контейнеры ──\n'
        if [[ -n "$running" ]]; then
            printf '%s\n' "$running"
        else
            printf '  (нет данных)\n'
        fi
        printf '\n── Веб-интерфейсы ──\n'
        is_selected "portainer"   && \
            printf '  Portainer:  http://%s:%s\n' "$ip" "$PORTAINER_PORT"
        is_selected "nginx_proxy" && \
            printf '  NPM:        http://%s:81 (admin@example.com / changeme)\n' "$ip"
        if is_selected "supabase"; then
            local ss="http"
            [[ "$SUPABASE_HTTPS" == "1" ]] && ss="https"
            printf '  Supabase Studio: %s://%s:%s\n' \
                "$ss" "${SUPABASE_DOMAIN:-$ip}" "$SUPABASE_PORT_STUDIO"
            printf '  Supabase API:    http://%s:%s\n' "$ip" "$SUPABASE_PORT_API"
            printf '  Supabase DB:     %s:%s\n' "$ip" "$SUPABASE_PORT_PG"
            [[ -f "$SETUP_DIR/supabase_credentials.txt" ]] && \
                printf '  Studio login:    %s\n' \
                    "$(<"$SETUP_DIR/supabase_credentials.txt")"
        fi
        if is_selected "n8n"; then
            local ns="http"
            [[ "$DOMAIN_HTTPS" == "1" ]] && [[ -n "$DOMAIN" ]] && ns="https"
            printf '  n8n:        %s://%s:%s\n' "$ns" "${DOMAIN:-$ip}" "$N8N_PORT"
        fi
        is_selected "apache" && \
            printf '  Apache:     http://%s:%s\n' "${DOMAIN:-$ip}" "$APACHE_HTTP_PORT"
        is_selected "qdrant" && \
            printf '  Qdrant:     http://%s:%s\n' "$ip" "$QDRANT_PORT"
        is_selected "ollama" && \
            printf '  Ollama:     http://%s:%s\n' "$ip" "$OLLAMA_PORT"
        if is_selected "cloudflared" && [[ -n "$CLOUDFLARE_DOMAIN" ]]; then
            printf '\n── Cloudflare Tunnel ──\n'
            printf '  Режим: %s\n' "$CLOUDFLARE_MODE"
            if [[ -n "$CLOUDFLARE_ROUTES" ]]; then
                local r host service
                local -a route_arr
                IFS=',' read -ra route_arr <<< "$CLOUDFLARE_ROUTES"
                for r in "${route_arr[@]}"; do
                    [[ -z "$r" ]] && continue
                    cf_route_to_host_service "$r" host service
                    [[ -n "$host" ]] && printf '  https://%s\n' "$host"
                done
            fi
        fi
        printf '\n── Файлы ──\n'
        printf '  Лог:       %s\n' "$LOG_FILE"
        printf '  Параметры: %s\n' "$PARAMS_FILE"
        printf '════════════════════════════════════════════\n'
    } > "$sf"
    chmod 600 "$sf"
    dialog --title "Итоги" --textbox "$sf" 32 80
}

###############################################################################
#  ПЕРЕУСТАНОВКА
###############################################################################
reinstall_service() {
    local svc="$1"
    pushd "$SETUP_DIR" >/dev/null || return 1
    case "$svc" in
        supabase)
            dialog --yes-label "Удалить ВСЕ" --no-label "Отмена" \
                --yesno "Переустановить Supabase?\n\nВСЕ ДАННЫЕ БУДУТ УДАЛЕНЫ!" \
                9 60 || { popd >/dev/null || true; return 0; }
            if [[ -d "$SETUP_DIR/supabase-docker" ]]; then
                pushd "$SETUP_DIR/supabase-docker" >/dev/null && \
                    docker compose -p supabase \
                        -f docker-compose.yml \
                        -f docker-compose.override.yml \
                        down -v >>"$LOG_FILE" 2>&1 || true
                popd >/dev/null || true
            fi
            rm -rf "$SETUP_DIR/supabase-docker"
            popd >/dev/null || true
            setup_supabase
            ;;
        cloudflared)
            generate_compose_file
            docker compose stop cloudflared   >>"$LOG_FILE" 2>&1 || true
            docker compose rm -fv cloudflared >>"$LOG_FILE" 2>&1 || true
            setup_cloudflared
            docker compose up -d cloudflared  >>"$LOG_FILE" 2>&1
            verify_cloudflared
            popd >/dev/null || true
            ;;
        *)
            generate_compose_file
            docker compose stop "$svc"    >>"$LOG_FILE" 2>&1 || true
            docker compose rm -fv "$svc"  >>"$LOG_FILE" 2>&1 || true
            docker compose up -d "$svc"   >>"$LOG_FILE" 2>&1
            popd >/dev/null || true
            ;;
    esac
    info_box "Готово" "${svc} переустановлен." 2
}

###############################################################################
#  СТАТУС
###############################################################################
show_status() {
    local st
    st=$(_mktemp)
    {
        printf '── docker compose (основные) ──\n'
        if [[ -f "$SETUP_DIR/docker-compose.yml" ]]; then
            pushd "$SETUP_DIR" >/dev/null 2>&1 && \
                docker compose ps 2>&1 && \
                popd >/dev/null 2>&1 || true
        else
            printf '(docker-compose.yml отсутствует)\n'
        fi
        printf '\n── docker compose (supabase) ──\n'
        if [[ -d "$SETUP_DIR/supabase-docker" ]]; then
            pushd "$SETUP_DIR/supabase-docker" >/dev/null 2>&1 && \
                docker compose -p supabase ps 2>&1 && \
                popd >/dev/null 2>&1 || true
        else
            printf '(не установлен)\n'
        fi
        printf '\n── Все контейнеры ──\n'
        docker ps --format \
            "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || true
        if docker ps --format '{{.Names}}' 2>/dev/null \
           | grep -q '^cloudflared$'; then
            printf '\n── Cloudflared логи ──\n'
            docker logs --tail 15 cloudflared 2>&1 || true
        fi
    } > "$st"
    dialog --title "Статус" --textbox "$st" 30 100
}

###############################################################################
#  POST-INSTALL МЕНЮ
###############################################################################
post_install_menu() {
    while true; do
        local c
        c=$(dialog --title "Управление" --cancel-label "Выход" \
            --menu "Выберите действие:" 20 65 9 \
            "1" "Добавить/изменить сервисы" \
            "2" "Переустановить сервис" \
            "3" "Показать статус" \
            "4" "Показать сводку" \
            "5" "Просмотр логов" \
            "6" "Полный сброс" \
            "7" "Копировать лог в /tmp" \
            "0" "Выход" \
            3>&1 1>&2 2>&3) || return 0

        case "$c" in
            1)
                show_service_menu || continue
                [[ ${#SELECTED_ARRAY[@]} -eq 0 ]] && {
                    info_box "" "Ничего не выбрано" 2; continue; }
                input_parameters || continue
                save_params
                setup_network
                setup_cloudflared
                generate_compose_file
                start_containers
                print_npm_info
                setup_supabase
                verify_cloudflared
                show_final_summary
                ;;
            2)
                local arr=() names svc
                names=$(docker ps --format '{{.Names}}' 2>/dev/null) || names=""
                for svc in postgres qdrant ollama apache nginx-proxy-manager \
                           cloudflared portainer n8n; do
                    printf '%s\n' "$names" | grep -qx "$svc" && \
                        arr+=("$svc" "$svc" off)
                done
                printf '%s\n' "$names" | grep -q "^supabase-" && \
                    arr+=("supabase" "Supabase (все)" off)
                if [[ ${#arr[@]} -eq 0 ]]; then
                    info_box "" "Нет запущенных сервисов" 2; continue
                fi
                local sel
                sel=$(_mktemp)
                dialog --checklist "Выберите для переустановки:" \
                    16 60 8 "${arr[@]}" 2>"$sel" || continue
                local raw item
                raw=$(tr -d '"\r' <"$sel")
                for item in $raw; do
                    [[ -n "$item" ]] && reinstall_service "$item"
                done
                ;;
            3) show_status ;;
            4) show_final_summary ;;
            5) dialog --title "Лог" --textbox "$LOG_FILE" 32 100 ;;
            6)
                dialog --yes-label "Удалить" --no-label "Отмена" \
                    --yesno "ПОЛНЫЙ СБРОС.\n\nУдалит:\n  • $STATE_DIR\n  • $SETUP_DIR\n  • Все контейнеры (с томами!)" \
                    11 60 || continue
                (   cd "$SETUP_DIR" 2>/dev/null && \
                    docker compose down -v 2>/dev/null || true
                )
                (   cd "$SETUP_DIR/supabase-docker" 2>/dev/null && \
                    docker compose -p supabase \
                        -f docker-compose.yml \
                        -f docker-compose.override.yml \
                        down -v 2>/dev/null || true
                )
                rm -rf "$STATE_DIR" "$SETUP_DIR"
                info_box "Готово" "Сброшено. Перезапуск..." 2
                exec "$0"
                ;;
            7)
                cp "$LOG_FILE" /tmp/install.log 2>/dev/null && \
                    chmod 644 /tmp/install.log || true
                local ip; ip=$(hostname -I | awk '{print $1}')
                dialog --title "Лог" --msgbox \
"  /tmp/install.log

Скачать локально:
  scp root@${ip}:/tmp/install.log ." 11 60
                ;;
            0) return 0 ;;
        esac
    done
}

###############################################################################
#  ГЛАВНАЯ
###############################################################################
main() {
    if ! grep -qi "ubuntu\|debian" /etc/os-release 2>/dev/null; then
        echo "Только Ubuntu/Debian"; exit 1
    fi
    if [[ "$EUID" -ne 0 ]]; then
        echo "Запустите с sudo"; exit 1
    fi
    if ! command -v dialog &>/dev/null; then
        apt-get update >/dev/null 2>&1 || true
        apt-get install -y dialog >/dev/null 2>&1 || {
            echo "Не удалось установить dialog"; exit 1; }
    fi

    local avail_gb
    avail_gb=$(df -BG / | awk 'NR==2{gsub(/G/,""); print $4}')
    if [[ "$avail_gb" =~ ^[0-9]+$ ]] && [[ $avail_gb -lt 5 ]]; then
        dialog --msgbox "Свободно ${avail_gb}GB, нужно ≥5GB" 7 50
        exit 1
    fi

    load_selected_services
    load_params

    if [[ $# -eq 2 ]] && [[ "$1" == "--reinstall" ]]; then
        reinstall_service "$2"; exit 0
    fi

    local state
    state=$(get_state)
    case "$state" in
        start)
            show_welcome
            show_service_menu || exit 0
            [[ ${#SELECTED_ARRAY[@]} -eq 0 ]] && {
                dialog --msgbox "Ничего не выбрано" 6 40; exit 1; }
            input_parameters || { save_state "start"; exit 4; }
            ensure_docker
            save_state "docker_installed"
            setup_network
            setup_cloudflared
            generate_compose_file
            start_containers
            print_npm_info
            setup_supabase
            verify_cloudflared
            save_state "completed"
            show_final_summary
            ;;
        docker_installed)
            # Прерванная установка — продолжаем
            ensure_docker
            setup_network
            setup_cloudflared
            generate_compose_file
            start_containers
            print_npm_info
            setup_supabase
            verify_cloudflared
            save_state "completed"
            show_final_summary
            ;;
        completed)
            # Только проверяем Docker и показываем сводку
            # НЕ перезапускаем все сервисы при каждом входе
            ensure_docker
            show_final_summary
            ;;
        *)
            save_state "start"
            exec "$0"
            ;;
    esac

    post_install_menu
}

main "$@"
