ensure_docker() {
    log_section "Docker check"
    if ! command -v docker &>/dev/null; then
        install_docker
    else
        if ! docker info &>/dev/null; then
            systemctl start docker 2>/dev/null || true
            sleep 3
        fi
        if ! docker compose version &>/dev/null; then
            run_with_progress "Docker" "Установка compose-plugin..." \
                apt-get install -y docker-compose-plugin
        fi
        verify_docker
    fi
}

install_docker() {
    log "Installing Docker..."
    run_with_progress "Docker" "Обновление apt..." apt-get update
    local sh
    sh=$(_mktemp)
    run_with_progress "Docker" "Скачивание установщика..." \
        bash -c "curl -fsSL https://get.docker.com -o '$sh'"
    run_with_progress "Docker" "Установка Docker..." bash "$sh"
    usermod -aG docker "$REAL_USER" 2>/dev/null || true
    systemctl enable docker --now >/dev/null 2>&1 || true

    if ! command -v docker &>/dev/null; then
        dialog --title "Ошибка" \
            --msgbox "Docker не установлен.\nЛог: $LOG_FILE" 8 55
        exit 1
    fi
    if ! docker compose version &>/dev/null; then
        run_with_progress "Docker" "Установка compose-plugin..." \
            apt-get install -y docker-compose-plugin
    fi
    verify_docker
}

verify_docker() {
    log "Verifying docker..."
    local out
    out=$(_mktemp)
    if docker run --rm hello-world >"$out" 2>&1; then
        log "Docker OK"
        return 0
    fi
    log "Docker FAILED, auto-repair..."
    cat "$out" >>"$LOG_FILE"

    if grep -qi "failed to lease\|containerd" "$out"; then
        info_box "Docker" "Проблема containerd. Починка..." 2
        systemctl stop docker containerd 2>/dev/null || true
        rm -rf /var/lib/containerd/io.containerd.metadata.v1.bolt/* \
               /var/lib/containerd/state/* \
               /var/lib/containerd/tmpmounts/* 2>/dev/null || true
        systemctl start containerd 2>/dev/null || true
        sleep 2
        systemctl start docker 2>/dev/null || true
        sleep 3
        if docker run --rm hello-world >"$out" 2>&1; then
            info_box "Docker" "Docker починен." 2
            return 0
        fi
    fi
    dialog --title "Ошибка Docker" --textbox "$out" 20 80
    exit 1
}

