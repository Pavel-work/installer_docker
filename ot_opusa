#  ШАГИ
###############################################################################
s_pg() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "[$((_STEP+1))/${_STEP_MAX}] PostgreSQL" \
        --inputbox "Пароль admin (пусто = сгенерировать)" \
        10 65 "${PGPASSWORD:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    PGPASSWORD=$(<"$TMP")
    [[ -z "$PGPASSWORD" ]] && \
        PGPASSWORD=$(openssl rand -base64 24 | tr -d '+=/' | cut -c1-24)
    dialog --title "PostgreSQL пароль" --ok-label "Далее" \
        --msgbox "Сохраните пароль:\n\n${PGPASSWORD}" 9 65
}

s_llm() {
    LLM_TYPE=$(dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "[$((_STEP+1))/${_STEP_MAX}] LLM Provider" \
        --radiolist "Выберите LLM провайдер:" 15 60 5 \
        "ollama"    "Ollama (локально)"    on \
        "openai"    "OpenAI"               off \
        "anthropic" "Anthropic Claude"     off \
        "deepseek"  "DeepSeek"             off \
        "custom"    "Custom URL"           off \
        3>&1 1>&2 2>&3) || { _nav_action="back"; return 1; }
    case "$LLM_TYPE" in
        openai)    LLM_API_URL="https://api.openai.com/v1" ;;
        anthropic) LLM_API_URL="https://api.anthropic.com/v1" ;;
        ollama)    LLM_API_URL="http://ollama:11434"; LLM_API_KEY="" ;;
        deepseek)  LLM_API_URL="https://api.deepseek.com/v1" ;;
        custom)
            dialog --ok-label "Далее" --cancel-label "Назад" \
                --inputbox "Введите URL API:" 9 60 "${LLM_API_URL:-}" 2>"$TMP" \
                || { _nav_action="back"; return 1; }
            LLM_API_URL=$(<"$TMP")
            ;;
    esac
    if [[ "$LLM_TYPE" != "ollama" ]]; then
        dialog --ok-label "Далее" --cancel-label "Назад" \
            --inputbox "API ключ для ${LLM_TYPE}:" 9 60 "${LLM_API_KEY:-}" 2>"$TMP" \
            || { _nav_action="back"; return 1; }
        LLM_API_KEY=$(<"$TMP")
    fi
}

s_domain() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "Домен" \
        --inputbox "Основной домен (пусто если нет):\n\nПример: example.com" \
        9 60 "${DOMAIN:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    DOMAIN=$(<"$TMP")
    if [[ -n "$DOMAIN" ]]; then
        if dialog --title "HTTPS" \
            --yes-label "Да (HTTPS)" --no-label "Нет (HTTP)" \
            --yesno "Доступ по HTTPS?\n(Да — если настроен SSL)" 8 60; then
            DOMAIN_HTTPS=1
        else
            DOMAIN_HTTPS=0
        fi
    else
        DOMAIN_HTTPS=0
    fi
}

s_n8n_port() { input_port "n8n" N8N_PORT 5678; }

s_n8n_db() {
    if dialog --yes-label "PostgreSQL" --no-label "SQLite" \
        --title "n8n База данных" \
        --yesno "Какую БД использовать для n8n?" 9 60; then
        N8N_DB_POSTGRES=1
    else
        N8N_DB_POSTGRES=0
    fi
    _nav_action="next"
}

s_supabase_domain() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --inputbox "Поддомен Supabase (пусто если нет):\n\nПример: supabase.example.com" \
        9 60 "${SUPABASE_DOMAIN:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    SUPABASE_DOMAIN=$(<"$TMP")
    if [[ -n "$SUPABASE_DOMAIN" ]]; then
        if dialog --yes-label "Да" --no-label "Нет" \
            --yesno "Supabase по HTTPS?" 7 50; then
            SUPABASE_HTTPS=1
        else
            SUPABASE_HTTPS=0
        fi
    else
        SUPABASE_HTTPS=0
    fi
}

s_jwt() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --title "JWT Secret" \
        --inputbox "Секрет JWT (пусто = сгенерировать; ≥32 символов)" \
        9 65 "${JWT_SECRET:-}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    JWT_SECRET=$(<"$TMP")
    if [[ -z "$JWT_SECRET" ]] || [[ ${#JWT_SECRET} -lt 32 ]]; then
        JWT_SECRET=$(openssl rand -hex 32)
    fi
    dialog --title "JWT Secret" --ok-label "Далее" \
        --msgbox "JWT Secret:\n\n${JWT_SECRET}" 9 75
}

s_supabase_ports() {
    while true; do
        local _sf
        _sf=$(_mktemp)
        {
            printf 'Порты Supabase:\n\n'
            printf '  Studio (Dashboard)   : %s\n' "$SUPABASE_PORT_STUDIO"
            printf '  Database (PostgreSQL) : %s\n' "$SUPABASE_PORT_PG"
            printf '  API Gateway (Kong)   : %s\n' "$SUPABASE_PORT_API"
            printf '  Pooler (Supavisor)   : %s\n' "$SUPABASE_PORT_POOLER"
        } > "$_sf"
        if dialog --title "Supabase порты" \
            --yes-label "Далее" --no-label "Изменить" \
            --yesno "$(cat "$_sf")" 16 60; then
            _nav_action="next"
            return 0
        fi

        local _cancelled=0 pv label dv val
        for pv in SUPABASE_PORT_STUDIO SUPABASE_PORT_PG \
                  SUPABASE_PORT_API SUPABASE_PORT_POOLER; do
            case "$pv" in
                SUPABASE_PORT_STUDIO) label="Studio";   dv=3000 ;;
                SUPABASE_PORT_PG)     label="Database"; dv=5432 ;;
                SUPABASE_PORT_API)    label="API/Kong"; dv=8000 ;;
                SUPABASE_PORT_POOLER) label="Pooler";   dv=6543 ;;
            esac
            dialog --ok-label "OK" --cancel-label "Назад" \
                --inputbox "Порт ${label} (по умолч. ${dv}):" \
                8 55 "${!pv}" 2>"$TMP" \
                || { _cancelled=1; break; }
            val=$(<"$TMP")
            if [[ "$val" =~ ^[0-9]+$ ]] && \
               [[ $val -ge 1 ]] && [[ $val -le 65535 ]]; then
                printf -v "$pv" "%s" "$val"
            fi
        done

        if [[ $_cancelled -eq 1 ]]; then
            _nav_action="back"
            return 1
        fi
    done
}

s_ap_path() {
    dialog --ok-label "Далее" --cancel-label "Назад" \
        --inputbox "Путь для сайтов Apache:" 9 60 \
        "${APACHE_WWW_PATH:-$SETUP_DIR/www}" 2>"$TMP" \
        || { _nav_action="back"; return 1; }
    APACHE_WWW_PATH=$(<"$TMP")
    [[ -z "$APACHE_WWW_PATH" ]] && APACHE_WWW_PATH="$SETUP_DIR/www"
    APACHE_WWW_PATH=$(realpath -m "$APACHE_WWW_PATH")
    mkdir -p "$APACHE_WWW_PATH" "$APACHE_WWW_PATH/conf"
    [[ ! -f "$APACHE_WWW_PATH/index.html" ]] && \
        echo '<h1>It works!</h1>' >"$APACHE_WWW_PATH/index.html"
}

